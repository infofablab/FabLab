@echo off
setlocal
set "FABLAB_SELF=%~f0"

start "" powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -STA -Command "$l=Get-Content -LiteralPath $env:FABLAB_SELF; $b=[Array]::IndexOf($l,'::FABLAB_GUI_PS1_BEGIN'); $e=[Array]::IndexOf($l,'::FABLAB_GUI_PS1_END'); if($b -lt 0 -or $e -le $b){exit 1}; $s=($l[($b+1)..($e-1)] -join [Environment]::NewLine); Invoke-Expression $s"

exit /b 0
::FABLAB_GUI_PS1_BEGIN
$ErrorActionPreference = "Stop"

$SelfPath = $env:FABLAB_SELF
$InstallDir = Join-Path $env:LOCALAPPDATA "FabLab\BambuStudio"
$UserCfg = Join-Path $env:APPDATA "BambuStudio"
$StudioExe = "C:\Program Files\Bambu Studio\bambu-studio.exe"
$ConfigPath = Join-Path $InstallDir "BambuStudio.conf"
$DiscoveryPath = Join-Path $InstallDir "BambuDiscovery-FabLab.ps1"
$UserConfigPath = Join-Path $UserCfg "BambuStudio.conf"
$HashPath = Join-Path $UserCfg "FabLab-BambuStudio.sha256"
$LogPath = Join-Path $InstallDir "configuration.log"

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
[System.Windows.Forms.Application]::EnableVisualStyles()

function Write-Log {
    param([string]$Message)
    try {
        $line = "[{0}] {1}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Message
        Add-Content -LiteralPath $LogPath -Value $line -Encoding UTF8
    } catch {}
}

function Extract-Payload {
    param(
        [string]$BeginMarker,
        [string]$EndMarker,
        [string]$OutputPath
    )

    if (-not $SelfPath -or -not (Test-Path -LiteralPath $SelfPath)) {
        throw "Le fichier de configuration principal est introuvable."
    }

    $lines = Get-Content -LiteralPath $SelfPath
    $b = [Array]::IndexOf($lines, $BeginMarker)
    $e = [Array]::IndexOf($lines, $EndMarker)

    if ($b -lt 0 -or $e -le $b) {
        throw "Données de configuration introuvables."
    }

    $data = ($lines[($b + 1)..($e - 1)] -join "").Trim()

    try {
        $bytes = [Convert]::FromBase64String($data)
    }
    catch {
        throw "Les données de configuration intégrées sont invalides."
    }

    [IO.File]::WriteAllBytes($OutputPath, $bytes)
}

function Close-BambuStudio {
    $running = @(Get-Process -Name "bambu-studio" -ErrorAction SilentlyContinue)

    if ($running.Count -eq 0) {
        return
    }

    foreach ($p in $running) {
        try {
            if ($p.MainWindowHandle -ne 0) {
                $null = $p.CloseMainWindow()
            }
        }
        catch {}
    }

    Start-Sleep -Milliseconds 700

    Get-Process -Name "bambu-studio" -ErrorAction SilentlyContinue |
        Stop-Process -Force -ErrorAction SilentlyContinue
}

function Stop-OldDiscovery {
    try {
        Get-CimInstance Win32_Process -Filter "Name='powershell.exe'" -ErrorAction SilentlyContinue |
            Where-Object {
                $_.CommandLine -like "*BambuDiscovery-FabLab.ps1*" -and
                $_.ProcessId -ne $PID
            } |
            ForEach-Object {
                Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue
            }
    }
    catch {}
}

# ------------------------------------------------------------
# GUI: elle est créée AVANT toute extraction/configuration.
# ------------------------------------------------------------

$form = New-Object System.Windows.Forms.Form
$form.Text = "Configuration Bambu Studio"
$form.StartPosition = "CenterScreen"
$form.FormBorderStyle = "FixedDialog"
$form.MaximizeBox = $false
$form.MinimizeBox = $false
$form.ShowInTaskbar = $true
$form.ClientSize = New-Object System.Drawing.Size(560, 235)
$form.TopMost = $true

$title = New-Object System.Windows.Forms.Label
$title.Text = "Configuration de Bambu Studio"
$title.Font = New-Object System.Drawing.Font("Segoe UI", 16, [System.Drawing.FontStyle]::Bold)
$title.AutoSize = $false
$title.TextAlign = "MiddleCenter"
$title.Location = New-Object System.Drawing.Point(20, 20)
$title.Size = New-Object System.Drawing.Size(520, 38)
$form.Controls.Add($title)

$subtitle = New-Object System.Windows.Forms.Label
$subtitle.Text = "Veuillez patienter pendant la configuration automatique."
$subtitle.Font = New-Object System.Drawing.Font("Segoe UI", 10)
$subtitle.AutoSize = $false
$subtitle.TextAlign = "MiddleCenter"
$subtitle.Location = New-Object System.Drawing.Point(20, 58)
$subtitle.Size = New-Object System.Drawing.Size(520, 28)
$form.Controls.Add($subtitle)

$progress = New-Object System.Windows.Forms.ProgressBar
$progress.Minimum = 0
$progress.Maximum = 100
$progress.Value = 2
$progress.Style = "Continuous"
$progress.Location = New-Object System.Drawing.Point(40, 105)
$progress.Size = New-Object System.Drawing.Size(480, 28)
$form.Controls.Add($progress)

$percent = New-Object System.Windows.Forms.Label
$percent.Text = "2 %"
$percent.Font = New-Object System.Drawing.Font("Segoe UI", 10, [System.Drawing.FontStyle]::Bold)
$percent.AutoSize = $false
$percent.TextAlign = "MiddleCenter"
$percent.Location = New-Object System.Drawing.Point(235, 137)
$percent.Size = New-Object System.Drawing.Size(90, 25)
$form.Controls.Add($percent)

$status = New-Object System.Windows.Forms.Label
$status.Text = "Initialisation..."
$status.Font = New-Object System.Drawing.Font("Segoe UI", 10)
$status.AutoSize = $false
$status.TextAlign = "MiddleCenter"
$status.Location = New-Object System.Drawing.Point(30, 166)
$status.Size = New-Object System.Drawing.Size(500, 34)
$form.Controls.Add($status)

$note = New-Object System.Windows.Forms.Label
$note.Text = "Ne fermez pas cette fenêtre."
$note.Font = New-Object System.Drawing.Font("Segoe UI", 8)
$note.AutoSize = $false
$note.TextAlign = "MiddleCenter"
$note.Location = New-Object System.Drawing.Point(30, 202)
$note.Size = New-Object System.Drawing.Size(500, 20)
$form.Controls.Add($note)

function Set-Progress {
    param([int]$Value, [string]$Text)

    if ($Value -lt 0) { $Value = 0 }
    if ($Value -gt 100) { $Value = 100 }

    $progress.Value = $Value
    $percent.Text = "$Value %"
    $status.Text = $Text

    $form.Refresh()
    [System.Windows.Forms.Application]::DoEvents()
}

function Show-ErrorBox {
    param([string]$Message)

    $status.Text = "Une erreur est survenue."
    $note.Text = "Veuillez contacter un technicien du Fab Lab."
    $form.Refresh()
    [System.Windows.Forms.Application]::DoEvents()

    [System.Windows.Forms.MessageBox]::Show(
        "La configuration n'a pas pu être terminée.`r`n`r`n$Message`r`n`r`nVeuillez contacter un technicien du Fab Lab.",
        "Configuration Bambu Studio",
        [System.Windows.Forms.MessageBoxButtons]::OK,
        [System.Windows.Forms.MessageBoxIcon]::Error
    ) | Out-Null
}

$success = $false
$errorMessage = ""

$form.Show()
$form.Activate()
[System.Windows.Forms.Application]::DoEvents()

try {
    Set-Progress 5 "Préparation..."

    if (-not (Test-Path -LiteralPath $StudioExe)) {
        throw "Bambu Studio n'est pas installé sur ce poste."
    }

    New-Item -ItemType Directory -Force -Path $InstallDir | Out-Null
    New-Item -ItemType Directory -Force -Path $UserCfg | Out-Null

    Write-Log "Début de la configuration."

    Set-Progress 12 "Fermeture de Bambu Studio s'il est ouvert..."
    Close-BambuStudio

    Set-Progress 22 "Chargement de la configuration..."

    Extract-Payload `
        "::FABLAB_CONFIG_BEGIN" `
        "::FABLAB_CONFIG_END" `
        $ConfigPath

    Extract-Payload `
        "::FABLAB_PS1_BEGIN" `
        "::FABLAB_PS1_END" `
        $DiscoveryPath

    if (-not (Test-Path -LiteralPath $ConfigPath)) {
        throw "Le fichier de configuration n'a pas pu être installé."
    }

    if (-not (Test-Path -LiteralPath $DiscoveryPath)) {
        throw "Le service de découverte des imprimantes n'a pas pu être installé."
    }

    Set-Progress 38 "Configuration des 8 imprimantes..."

    if (Test-Path -LiteralPath $UserConfigPath) {
        Copy-Item `
            -LiteralPath $UserConfigPath `
            -Destination ($UserConfigPath + ".bak") `
            -Force
    }

    Copy-Item `
        -LiteralPath $ConfigPath `
        -Destination $UserConfigPath `
        -Force

    $masterHash = (Get-FileHash -LiteralPath $ConfigPath -Algorithm SHA256).Hash
    [IO.File]::WriteAllText(
        $HashPath,
        $masterHash,
        [Text.Encoding]::ASCII
    )

    Set-Progress 58 "Configuration de la découverte réseau..."

    $runCmd = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "' + $DiscoveryPath + '"'

    New-ItemProperty `
        -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Run" `
        -Name "FabLab-BambuStudio" `
        -Value $runCmd `
        -PropertyType String `
        -Force | Out-Null

    Stop-OldDiscovery

    Start-Process `
        -FilePath "powershell.exe" `
        -ArgumentList @(
            "-NoProfile",
            "-ExecutionPolicy", "Bypass",
            "-WindowStyle", "Hidden",
            "-File", "`"$DiscoveryPath`""
        ) `
        -WindowStyle Hidden

    Set-Progress 75 "Activation des imprimantes du Fab Lab..."
    Start-Sleep -Seconds 2

    Set-Progress 88 "Vérification de la configuration..."

    if (-not (Test-Path -LiteralPath $UserConfigPath)) {
        throw "La configuration utilisateur n'a pas été enregistrée."
    }

    $userHash = (Get-FileHash -LiteralPath $UserConfigPath -Algorithm SHA256).Hash

    if ($userHash -ne $masterHash) {
        throw "La vérification de la configuration a échoué."
    }

    Write-Log "Configuration validée."
    $success = $true
}
catch {
    $errorMessage = $_.Exception.Message
    Write-Log ("ERREUR : " + $errorMessage)
}

if ($success) {
    Set-Progress 96 "Ouverture de Bambu Studio..."

    Close-BambuStudio
    Start-Sleep -Milliseconds 400
    Start-Process -FilePath $StudioExe

    Set-Progress 100 "Configuration terminée."
    $note.Text = "Bambu Studio est prêt à être utilisé."
    $form.Refresh()
    [System.Windows.Forms.Application]::DoEvents()

    Write-Log "Configuration terminée avec succès."

    Start-Sleep -Seconds 2
    $form.Close()
    exit 0
}
else {
    Show-ErrorBox $errorMessage
    $form.Close()
    exit 1
}
::FABLAB_GUI_PS1_END
::FABLAB_CONFIG_BEGIN

::FABLAB_CONFIG_END
::FABLAB_PS1_BEGIN

::FABLAB_PS1_END
